DB_HOST=127.0.0.1
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=dswd_ictms
JWT_SECRET=replace-with-a-long-random-secret
SESSION_IDLE_TIMEOUT_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Comma-separated exact IPv4 addresses or IPv4 CIDR ranges allowed to use
# the no-login /live-monitoring page. Empty means nobody is allowed.
PUBLIC_MONITORING_ALLOWED_IPS=192.168.1.20,192.168.1.0/24
# Only these directly-connected proxies may supply X-Real-IP/X-Forwarded-For.
TRUSTED_PROXY_IPS=127.0.0.1,::1
RECAPTCHA_SITE_KEY=your-google-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-google-recaptcha-v3-secret-key
RECAPTCHA_MIN_SCORE=0.5
SMTP_HOST=smtp.example.gov.ph
SMTP_PORT=587
SMTP_USER=notifications@example.gov.ph
SMTP_PASS=your-smtp-password

# Redirect HTTP to HTTPS.
server {
    listen 80;
    listen [::]:80;

    server_name 172.31.32.90;

    return 301 https://172.31.32.90$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name 172.31.32.90;

    root /var/www/fo3_ticketing/frontend/dist;
    index index.html;

    access_log /var/log/nginx/fo3_access.log;
    error_log /var/log/nginx/fo3_error.log;

    # TLS certificate.
    ssl_certificate /etc/ssl/certs/SLLCertificate396.cer;
    ssl_certificate_key /etc/ssl/certs/webname396.key;

    # Strong TLS configuration.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5:!3DES;
    ssl_prefer_server_ciphers off;

    ssl_session_cache shared:ICTDeskSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers applied by default.
    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.google.com; frame-src https://www.google.com; worker-src 'self' blob:;" always;

    # Block hidden files such as .env and .git.
    location ~ /\.(?!well-known/) {
        return 404;
    }

    # Block backup files, source maps, logs, SQL files, and temporary files.
    location ~* \.(?:env|bak|old|orig|save|swp|swo|tmp|map|log|sql)$ {
        return 404;
    }

    # Block probes for source code and internal application directories.
    location ~* ^/(?:backend|src|node_modules|migrations|uploads)(?:/|$) {
        return 404;
    }

    # Vite generates content-hashed filenames for JS and CSS assets.
    # These files can safely use long-lived immutable caching.
    location ^~ /assets/ {
        try_files $uri =404;

        expires 1y;

        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.google.com; frame-src https://www.google.com; worker-src 'self' blob:;" always;
    }

    # Never cache the SPA entry document.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, private, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;

        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.google.com; frame-src https://www.google.com; worker-src 'self' blob:;" always;
    }

    # React routes fall back to index.html and must not be cached.
    location / {
        try_files $uri $uri/ /index.html;

        add_header Cache-Control "no-store, no-cache, must-revalidate, private, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;

        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.google.com; frame-src https://www.google.com; worker-src 'self' blob:;" always;
    }

    # Proxy API requests to the local Node.js backend.
    location /api/ {
        proxy_pass http://127.0.0.1:3001;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}